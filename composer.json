{
    "name": "taggrs/magento2-data-layer",
    "description": "This extension collect eccommerce data from Magento 2 and pushes it to the Google Tag Manager DataLayer.",
    "type": "magento2-module",
    "license": [
        "GPL-3.0-or-later"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Taggrs\\DataLayer\\": ""
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    }
}
